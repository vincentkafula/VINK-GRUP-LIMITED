# Validator settings (copy to .env on the device; never commit it)
DEVICE_ID=VAL-0001
DEVICE_SECRET=                 # 64 hex characters, shown once when the device was registered in the dashboard
SERVER_URL=http://localhost:4000
ROUTE_ID=1
STOP_ID=0                      # the vehicle's console or GPS updates it: POST http://127.0.0.1:7070/stop {"stopId":101}
SQLITE_PATH=./validator.db
SYNC_INTERVAL_SECONDS=30
FEEDBACK=console               # console | gpio (Raspberry Pi LEDs and buzzer)
CONTROL_PORT=7070

# Keys. A validator needs ONLY the DEBIT and TICKET master keys. Development only: production should use an ExternalKeyProvider (KMS / HSM / SAM).
AFC_MASTER_KEY_DEBIT=          # 32 hex characters

# GPIO feedback (BCM pin numbers)
# GPIO_GREEN=17
# GPIO_RED=27
# GPIO_BUZZER=22

# Production keys: a sealed key file (see README: Keys) instead of AFC_MASTER_KEY_* variables
# AFC_KEY_FILE=/etc/afc/validator.sealed
# AFC_KEY_PASSPHRASE_FILE=/run/credentials/afc-validator/passphrase
