# Copy to .env (never commit it) and fill in every value below.
# Generate secrets with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- server (docker compose) ---
POSTGRES_PASSWORD=
JWT_SECRET=                  # 32+ characters, signs staff sign-in tokens
DEVICE_KEY_MASTER=           # exactly 64 hex characters; every device's signing secret is derived from it. Losing it means re-issuing every device secret.
DASHBOARD_URL=http://localhost:3000        # where staff open the dashboard (the API only accepts browser calls from here)
API_PUBLIC_URL=http://localhost:4000       # where the BROWSER reaches the API (baked into the dashboard build)
MOBILE_MONEY_WEBHOOK_SECRET=               # shared secret your mobile-money provider signs callbacks with; leave empty to keep the webhook switched off
SEED_ADMIN_PASSWORD=                       # first-run staff password for the seed script; if empty a random one is printed once

# --- validator (set on each device, not here) ---
# DEVICE_ID=VAL-0001
# DEVICE_SECRET=<64 hex characters shown once when the device was registered in the dashboard>
# SERVER_URL=https://api.example.com
# ROUTE_ID=1
# STOP_ID=0
# AFC_MASTER_KEY_DEBIT=<32 hex characters>   # development only. In production use a KMS / HSM / NXP SAM (see README: Keys)

# --- single-trip tickets (Ultralight) and mobile money ---
TICKET_SIGNING_KEY=          # base64 private key from: npm run tickets -- keygen   (server secret store only). Empty = ticket endpoints answer 503
TICKET_KEY_ID=1
MOBILE_MONEY_PROVIDER=generic   # which adapter reads the provider's callbacks (see backend/src/domain/mobileMoney.ts)
