# API settings for running it directly (npm run dev -w backend). With Docker, use the .env in the folder above instead.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://afc:CHANGE_ME@localhost:5432/afc
JWT_SECRET=                    # 32+ characters (production: required)
DEVICE_KEY_MASTER=             # 64 hex characters (production: required)
CORS_ORIGIN=http://localhost:3000
MOBILE_MONEY_WEBHOOK_SECRET=
AUTO_BLOCK_HIGH_ANOMALIES=3    # serious reconciliation problems in 24 h before a card is blocked automatically
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=10            # sign-in attempts per address per 15 minutes
TICKET_SIGNING_KEY=            # base64 PKCS8 Ed25519 private key (npm run tickets -- keygen); empty disables tickets in production
TICKET_KEY_ID=1
TICKET_RETIRED_KEYS=           # old public keys still accepted: 1:<64 hex>,2:<64 hex>
MOBILE_MONEY_PROVIDER=generic
