# Copy to .env and fill in real values before building/deploying.

# The one variable that connects the frontend to the backend. Every
# service file (apiClient, marketplaceApi, mvnoApi, bankingApi,
# healingAppleApi, vehicleApi, currencyStore, applicationsApi) and every
# component that builds its own request reads this through the single
# shared src/app/services/config.ts — change it here, not in code.
# The WebSocket URL (used for live feeds) is derived automatically from
# this same value, so there's no separate variable to keep in sync.
VITE_API_URL=http://localhost:3001

# Supabase — NOT the API backend (that's VITE_API_URL above, the real
# Express/Postgres server). These are unused leftovers from an earlier
# prototype iteration; safe to leave unset unless something new is built
# against Supabase specifically.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Web push notifications
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Payments (only needed once live processing is wired up)
VITE_PEACH_MERCHANT_ID=your-merchant-id

# Maps
VITE_GOOGLE_MAPS_KEY=your-maps-key

# Analytics / monitoring
VITE_POSTHOG_KEY=your-posthog-key
VITE_SENTRY_DSN=your-sentry-dsn
