# Copy to .env and fill in real values before building/deploying.

# The one variable that connects the frontend to the backend. Every
# service file (apiClient, marketplaceApi, mvnoApi, bankingApi,
# healingAppleApi, vehicleApi, currencyStore, applicationsApi) and every
# component that builds its own request reads this through the single
# shared src/app/services/config.ts — change it here, not in code.
# The WebSocket URL (used for live feeds) is derived automatically from
# this same value, so there's no separate variable to keep in sync.
VITE_API_URL=http://localhost:3001

# Supabase — NOT the API backend (that's VITE_API_URL above, the real
# Express/Postgres server). These are unused leftovers from an earlier
# prototype iteration; safe to leave unset unless something new is built
# against Supabase specifically.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Web push notifications
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Payments (only needed once live processing is wired up)
VITE_PEACH_MERCHANT_ID=your-merchant-id

# Maps
VITE_GOOGLE_MAPS_KEY=your-maps-key

# Analytics / monitoring
VITE_POSTHOG_KEY=your-posthog-key
VITE_SENTRY_DSN=your-sentry-dsn

# ── Backend (server/.env, never committed) ───────────────────────────────────
# Required in production: the server refuses to start without it. openssl rand -hex 64
# JWT_SECRET=
# Passwords for the seeded accounts (>= 12 chars). Unset in production = account not created;
# unset in development = random password printed once to the console. See DEV_CREDENTIALS.md.
# SEED_PASSWORD_ADMIN=
# SEED_PASSWORD_OWNER=
# SEED_PASSWORD_NOC1=
# SEED_PASSWORD_BILLING1=
# SEED_PASSWORD_CUSTOMER1=
# Local development only: pre-fill the sign-in form (put in .env.local; ignored by production builds)
# VITE_DEV_LOGIN_USER=
# VITE_DEV_LOGIN_PASSWORD=

# ── Payments (server/.env) — sandbox only until docs/payments/GO_LIVE_CHECKLIST.md is complete ──
# PAYMENTS_MODE=sandbox            # "live" is refused unless every guard in server/src/payments/config.ts passes
# ISSUING_PROVIDER=mock            # mock | paymentology (adapter is a stub until Paymentology's docs/sandbox are available)
# ACQUIRING_PROVIDER=mock          # mock only; a real acquiring PSP has not been chosen yet
# Sandbox credentials (never reused for live):
# SANDBOX_PAYMENTOLOGY_BASE_URL=
# SANDBOX_PAYMENTOLOGY_API_KEY=
# SANDBOX_PAYMENTOLOGY_WEBHOOK_SECRET=
# Live credentials are different variables (LIVE_PAYMENTOLOGY_*), set only on the live service.
# Webhook simulator (sandbox only): WEBHOOK_SIM_ALLOWED_HOSTS=
