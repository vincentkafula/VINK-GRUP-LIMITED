# Copy to .env and fill in real values before deploying.

PORT=3001
NODE_ENV=production

# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-before-deploying

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Postgres — attach a Railway Postgres plugin to this service and it auto-
# injects this. When set, auth + marketplace read/write real Postgres
# tables (schema + demo data are created automatically on first boot).
# When unset, those two modules fall back to in-memory demo data.
# Everything else (banking, AFC, vehicles, levy, financial reports, MVNO)
# is in-memory regardless — not migrated yet.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Only needed if this backend talks directly to Supabase (service role, server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Mastercard Open Banking integration (sandbox) ─────────────────────────
# From the Mastercard Developer Portal, under your project's credentials.
# Never commit real values here — set them directly in Railway's environment
# variables instead. See DEV_CREDENTIALS.md for the full setup walkthrough.
# No private key needed for this product — Partner ID + Partner Secret +
# App Key are exchanged for a bearer token, confirmed against Mastercard's
# own open-banking-reference-application on GitHub.
# MASTERCARD_PARTNER_ID=your-partner-id-here
# MASTERCARD_PARTNER_SECRET=your-partner-secret-here
# MASTERCARD_APP_KEY=your-app-key-here
# MASTERCARD_API_BASE_URL=https://api.finicity.com

